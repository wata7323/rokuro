// Cloudflare Workers の設定（GitHub から自動で公開されるときに使われる）
{
  // ↓ Cloudflare のダッシュボードに表示されている Worker の名前と同じにする
  "name": "rokuro",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  // index.html・og/・k/ などをそのまま配信する（.assetsignore に書いたものは配信しない）
  "assets": { "directory": ".", "binding": "ASSETS" },
  // 番付とプレイ数の保存先（Durable Object。無料プランで使える SQLite 版）。ダッシュボードでの作成は不要
  "durable_objects": {
    "bindings": [{ "name": "BOARD", "class_name": "Board" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Board"] }]
}
